target/
# Cargo artifacts can also appear in nested workspaces (fuzz/ has its own
# target directory); never ship them in a build context.
**/target/
fuzz/target/
.git/
.github/
data/
docs/
scripts/
.opencode/
docker-compose*.yml
# Release staging directory (populated by release.yml); never part of a build.
artifacts/
# prebuilt/ is deliberately NOT ignored: Dockerfile.release consumes it.
# HA deployment material (certificates, node configs, generated keys).
ha/
# Local environment and any PEM/key material must never enter the build context.
.env
*.pem
*.key
*.log
__pycache__/
*.pyc
